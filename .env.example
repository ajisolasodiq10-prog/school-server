# Copy this file to ".env" and adjust. Never commit ".env".

# Port the API listens on
PORT=

# development | production
NODE_ENV=

# Local MongoDB. 127.0.0.1 is used instead of "localhost" because newer Node
# versions may resolve "localhost" to IPv6, which MongoDB doesn't listen on by default.
# MongoDB Atlas example (use YOUR user, password, cluster and keep the database name):
MONGODB_URI=

# Frontend origin(s) allowed by CORS. Vite's default is http://localhost:5173.
# Separate several origins with commas.
CLIENT_ORIGIN=

# ---- Account Management Backend ---------------------------------------------
# Passwords, sign-in, activation and password reset live in a SEPARATE service. This server
# never stores a password or signs a token: it calls that service and verifies its tokens.

# REQUIRED. Base URL of the Account Management Backend (https:// in production, no trailing slash).
ACCOUNT_SERVICE_URL=

# REQUIRED. Secret this server sends (X-API-Key) on every server-to-server call. At least 32 random
# characters; the same value must be configured at the account service. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCOUNT_SERVICE_API_KEY=

# REQUIRED. The account service's PUBLIC key (PEM), used to verify the tokens it issues. Never put a
# private key here. In a one-line variable write the line breaks as \n.
ACCOUNT_TOKEN_PUBLIC_KEY=

# Token checks (defaults shown). Only asymmetric algorithms are accepted (RS256, ES256, EdDSA...).
ACCOUNT_TOKEN_ALGORITHMS=
ACCOUNT_TOKEN_ISSUER=
ACCOUNT_TOKEN_AUDIENCE=
ACCOUNT_TOKEN_CLOCK_TOLERANCE_SECONDS=

# Network behaviour. Timeout per call (ms); retries apply to READ calls only. The account status is
# cached this many seconds per account: a deactivated account is locked out within this time
# (0 = ask the account service on every request).
ACCOUNT_SERVICE_TIMEOUT_MS=
ACCOUNT_SERVICE_READ_RETRIES=
ACCOUNT_STATUS_CACHE_SECONDS=

# Activation / reset link requests allowed per administrator within the window.
ACCOUNT_LINK_RATE_WINDOW_MINUTES=15
ACCOUNT_LINK_MAX_REQUESTS=30

# Optional: for a single-school installation, the school code the public website endpoints use
# when the request does not include "schoolCode".
DEFAULT_SCHOOL_CODE=

# ---- Result PINs -------------------------------------------------------------

# Failed PIN attempts allowed within the window: per signed-in user, per student, per IP.
PIN_RATE_WINDOW_MINUTES=
PIN_MAX_FAILED_ATTEMPTS=
PIN_MAX_FAILED_ATTEMPTS_PER_STUDENT=
PIN_MAX_FAILED_ATTEMPTS_PER_IP=

# ---- Deployment --------------------------------------------------------------

# Number of reverse proxies in front of the API (nginx, a load balancer, a hosting
# platform...). Leave 0 when clients connect directly. Set it correctly in production,
# otherwise rate limiting sees the proxy's address instead of the real client's.
TRUST_PROXY=


